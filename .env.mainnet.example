# ============================================
# Mainnet-Beta Configuration Template
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# ============================================
# Server Configuration
# ============================================
PORT=3000
NODE_ENV=production

# ============================================
# Solana Blockchain Configuration
# ============================================
SOLANA_NETWORK=mainnet-beta
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_MAINNET_KEY

# ============================================
# Wallets (Public only - no private keys in env.example)
# ============================================
SOLANA_PUBLIC_KEY=YOUR_MAINNET_WALLET_PUBLIC_KEY

# Real Mainnet token addresses for testing
TEST_WALLET_ADDRESS=YOUR_MAINNET_WALLET_ADDRESS
TEST_TOKEN_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v  # USDC Mainnet

# ============================================
# Program IDs (same across all networks)
# ============================================
COMPUTE_BUDGET_PROGRAM_ID=ComputeBudget111111111111111111111111111111
SYSTEM_PROGRAM_ID=11111111111111111111111111111111
TOKEN_PROGRAM_ID=TokenkegQfeZyiNwAJbGKPFXCWuBvf9Ss623VQ5DA
METADATA_PROGRAM_ID=metaqbxxUerdq28cj1RbAWkYQm3ybzjb6a8bt518x1s
WRAPPED_SOL_MINT=So11111111111111111111111111111111111111112

# ============================================
# Security
# ============================================
JWT_SECRET=your-strong-production-jwt-secret-min-32-chars
CORS_ORIGINS=https://yourdomain.com

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Database Configuration
# ============================================
DB_HOST=your-production-db-host
DB_PORT=5432
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password
DB_DATABASE=solana_cache
